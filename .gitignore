# Brouillons de travail — bancs de mesure, captures avant/après, étapes
# intermédiaires d'images —, jamais lus par l'application ni par le build.
# Le dossier était suivi jusqu'au commit a0eca31 (489 fichiers, 38 Mo), qui l'a
# retiré ; l'historique garde ce qu'il contenait : `git show <commit>:<chemin>`.
tmp/

# Sauvegardes de la base (`npm run backup:db`, scripts/export_supabase_backup.mjs).
# Elles contiennent des DONNÉES PERSONNELLES : adresses e-mail, pseudos,
# signalements rédigés par les joueurs. Elles ne doivent jamais entrer dans le
# dépôt — un dépôt public ou un artefact GitHub les sortirait de France, en
# contradiction avec la politique de confidentialité de MotMan.
# Le script écrit par défaut HORS du dépôt (~/MotMan-sauvegardes/motman-<date>/) ;
# ces lignes ne sont qu'un filet de sécurité si MOTMAN_BACKUP_DIR redirige
# l'export ici par erreur. Les trois `.sql` couvrent un `supabase db dump`
# lancé à la main, l'ancienne méthode.
/motman-20[0-9][0-9]-*/
MotMan-sauvegardes/
motman-sauvegardes/
sauvegardes/
/roles.sql
/schema.sql
/data.sql

# >>> atelier privé
# Tout ce qui fabrique les grilles, et donc en porte les SOLUTIONS : les
# scripts Python et leurs données, le catalogue source et sa projection, la
# boîte de dépôt de l'Éditeur (ses lots approuvés, `review.html` compris). Le
# dépôt est public : ces fichiers publieraient les réponses des défis à venir.
#
# Ils sont suivis par l'ATELIER, un dépôt git privé superposé à cette copie de
# travail (`npm run atelier`), jamais par ce dépôt-ci. `scripts/atelier.mjs`
# lit CE bloc pour savoir quoi suivre : c'est la seule liste. Et
# `npm run check:atelier` échoue si un fichier suivi ici tombe sous un motif.
/scripts/*.py
/scripts/tests/*.py
/src/data/grid.catalog.json
/src/data/runtime.grid.catalog.json
/src/data/grid-generation*/
/src/data/pool/
/src/data/.grid-generation.lock
/src/data/bench-hard-*.json
/src/data/candidate-*.json
/src/data/easy-candidate-*.json
/src/data/easy-v2-candidate-*.json
/src/data/csp-*.json
/src/data/csp2-*.json
/src/data/smoke-*.json
/src/data/generated.easy.json
/src/data/crossword.*
/src/data/jeuxdemots.*
/src/data/lexique.*
/src/data/fill.wordlist.large.*
/MotMan Grilles prêtes/
# Les dessins-indices, souvent nommés d'après leur réponse, et identiques aux
# images que le catalogue envoie au jeu : publiés, ils permettaient de retrouver
# une réponse à partir de l'image. Le jeu ne les lit pas (le catalogue les porte
# en data:) ; seuls les scripts d'intégration vérifient qu'ils existent.
/dessins-indices/
# <<< atelier privé

# Le dossier git de l'atelier lui-même.
/.atelier-git/

# Construction du site pour la racine, zippee en mise a jour embarquee (CI).
dist-app
android/app/src/debug/google-services.json
